        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nhide circle\n\n|Tosador|\nstart\nrepeat\n:Identificar tutor e pet;\n\n|Sistema|\n:Buscar cadastro do tutor e do pet;\nif (tutor e pet encontrados?) then ([sim])\n  break\nelse ([não])\n  |Tosador|\n  :Cadastrar tutor e pet;\nendif\nrepeat while\n\n|Sistema|\nif (pet possui restrição de saúde?) then ([sim])\n  :Alertar restrição crítica de saúde;\n  stop\nelse ([não])\n  |Tosador|\n  :Informar data, horário e serviço;\n  |Sistema|\n  :Verificar disponibilidade do tosador;\n  if (horário disponível?) then ([não])\n    :Informar choque de horário;\n    stop\n  else ([sim])\n    |Tosador|\n    :Confirmar o agendamento;\n    |Sistema|\n    :Registrar agendamento e marcar como aguardando;\n    stop\n  endif\nendif\n@uml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="tPqnhvJW8CtdoUX8kExA-1">
